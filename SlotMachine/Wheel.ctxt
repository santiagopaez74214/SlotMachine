comment1.text=\r\n\ Default\ constructor\ for\ objects\ of\ class\ Wheel.\r\n\ Initializes\ an\ empty\ wheel\ with\ default\ visual\ settings\ and\ positions.\r\n
comment10.params=
comment10.target=void\ spin()
comment10.text=\r\n\ Spins\ the\ wheel\ forward\ by\ exactly\ one\ position.\r\n
comment11.params=times
comment11.target=void\ spin(int)
comment11.text=\r\n\ Spins\ the\ wheel\ by\ a\ specified\ number\ of\ positions.\r\n\ Supports\ negative\ numbers\ to\ spin\ backwards.\r\n\ \r\n\ @param\ times\ The\ number\ of\ positions\ to\ spin\ the\ wheel.\r\n
comment12.params=
comment12.target=void\ lock()
comment12.text=\r\n\ Locks\ the\ wheel.\r\n
comment13.params=
comment13.target=void\ unlock()
comment13.text=\r\n\ Unlocks\ the\ wheel.\r\n
comment14.params=
comment14.target=boolean\ isLocked()
comment14.text=\r\n\ Checks\ if\ the\ wheel\ is\ locked.\r\n\ @return\ true\ if\ locked,\ false\ if\ not\ locked.\r\n
comment15.params=
comment15.target=java.lang.String\ getVisibleSymbol()
comment15.text=\r\n\ Retrieves\ the\ color\ of\ the\ symbol\ that\ is\ currently\ visible\ on\ the\ wheel.\r\n\ \r\n\ @return\ A\ String\ representing\ the\ color\ of\ the\ visible\ symbol,\ or\ an\ empty\ string\ if\ the\ wheel\ has\ no\ symbols.\r\n
comment16.params=
comment16.target=java.lang.String[]\ getSymbols()
comment16.text=\r\n\ Retrieves\ an\ array\ containing\ the\ colors\ of\ all\ symbols\ present\ in\ the\ wheel.\r\n\ \r\n\ @return\ An\ array\ of\ Strings\ containing\ the\ colors\ of\ all\ symbols.\r\n
comment17.params=
comment17.target=int\ getPosition()
comment17.text=\r\n\ Returns\ the\ position\ of\ this\ wheel.\r\n\r\n\ @return\ the\ position.\r\n
comment18.params=other
comment18.target=boolean\ copyStateFrom(Wheel)
comment18.text=\r\n\ Copies\ the\ current\ symbol\ from\ another\ wheel.\r\n\ @param\ other\ the\ wheel\ whose\ state\ will\ be\ copied.\r\n\ @return\ true\ if\ the\ state\ was\ copied.\r\n
comment2.params=pos
comment2.target=Wheel(int)
comment2.text=\r\n\ Creates\ a\ new\ Wheel\ with\ a\ specific\ identifier/position\ and\ sets\ its\ visual\ dimensions.\r\n\ \r\n\ @param\ pos\ The\ initial\ position\ or\ identifier\ for\ this\ wheel.\r\n
comment3.params=x\ y
comment3.target=void\ setPosition(int,\ int)
comment3.text=\r\n\ Defines\ the\ visual\ position\ of\ the\ wheel\ on\ the\ canvas\ and\ centers\ its\ symbols.\r\n\ \r\n\ @param\ x\ The\ X\ coordinate\ for\ the\ wheel's\ position.\r\n\ @param\ y\ The\ Y\ coordinate\ for\ the\ wheel's\ position.\r\n
comment4.params=color
comment4.target=boolean\ addSymbol(java.lang.String)
comment4.text=\r\n\ Adds\ a\ normal\ symbol\ with\ the\ specified\ color.\r\n\r\n\ @param\ color\ the\ color\ of\ the\ symbol.\r\n\ @return\ true\ if\ added\ successfully.\r\n
comment5.params=newSymbol
comment5.target=boolean\ addSymbol(Symbol)
comment5.text=\r\n\ Adds\ a\ symbol\ object\ to\ the\ wheel.\r\n\r\n\ @param\ newSymbol\ the\ symbol\ to\ add.\r\n\ @return\ true\ if\ added\ successfully.\r\n
comment6.params=color
comment6.target=boolean\ setSymbolAsCurrent(java.lang.String)
comment6.text=\r\n\ Sets\ a\ specific\ symbol\ as\ the\ currently\ visible\ one\ on\ the\ wheel.\r\n\ \r\n\ @param\ color\ The\ color\ of\ the\ symbol\ to\ be\ displayed.\r\n\ @return\ true\ if\ the\ symbol\ was\ found\ and\ set\ as\ current,\ false\ otherwise.\r\n
comment7.params=
comment7.target=void\ makeVisible()
comment7.text=\r\n\ Makes\ the\ wheel\ and\ its\ currently\ active\ symbol\ visible\ on\ the\ canvas.\r\n
comment8.params=
comment8.target=void\ makeInvisible()
comment8.text=\r\n\ Makes\ the\ wheel\ and\ its\ currently\ active\ symbol\ invisible\ on\ the\ canvas.\r\n
comment9.params=color
comment9.target=boolean\ delSymbol(java.lang.String)
comment9.text=\r\n\ Deletes\ the\ symbol\ that\ matches\ the\ specified\ color\ from\ the\ wheel.\r\n\ \r\n\ @param\ color\ The\ color\ of\ the\ symbol\ to\ be\ deleted.\r\n\ @return\ true\ if\ the\ symbol\ was\ successfully\ deleted,\ false\ if\ the\ symbol\ was\ not\ found.\r\n
