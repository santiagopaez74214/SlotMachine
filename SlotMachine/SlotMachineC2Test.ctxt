#BlueJ class context
comment0.target=SlotMachineC2Test
comment0.text=\r\n\ Pruebas\ unitarias\ de\ la\ clase\ SlotMachine.\r\n\r\n\ Cada\ m\u00E9todo\ p\u00FAblico\ de\ SlotMachine\ tiene\ dos\ pruebas\:\r\n\ una\ para\ verificar\ lo\ que\ deber\u00EDa\ hacer\ y\ otra\ para\ verificar\r\n\ lo\ que\ no\ deber\u00EDa\ hacer.\r\n\r\n\ @author\ David\ P\u00E1ez\ y\ Joseph\ Ca\u00F1on\r\n\ @version\ 07/09/2026\r\n
comment1.params=
comment1.target=void\ setUp()
comment1.text=\r\n\ Crea\ una\ nueva\ m\u00E1quina\ antes\ de\ cada\ prueba.\r\n
comment10.params=
comment10.target=void\ shouldPlaceExistingSymbol()
comment10.text=\r\n\ Verifica\ que\ se\ pueda\ colocar\ un\ s\u00EDmbolo\ existente\r\n\ como\ s\u00EDmbolo\ actual.\r\n
comment11.params=
comment11.target=void\ shouldNotPlaceNonExistingSymbol()
comment11.text=\r\n\ Verifica\ que\ no\ se\ pueda\ colocar\ un\ s\u00EDmbolo\ que\ no\ existe.\r\n
comment12.params=
comment12.target=void\ shouldSpinExistingWheel()
comment12.text=\r\n\ Verifica\ que\ una\ rueda\ existente\ pueda\ girar.\r\n
comment13.params=
comment13.target=void\ shouldNotSpinNonExistingWheel()
comment13.text=\r\n\ Verifica\ que\ no\ se\ pueda\ girar\ una\ rueda\ inexistente.\r\n
comment14.params=
comment14.target=void\ shouldSpinAllWheels()
comment14.text=\r\n\ Verifica\ que\ se\ puedan\ girar\ todas\ las\ ruedas.\r\n
comment15.params=
comment15.target=void\ shouldNotSpinWithoutWheels()
comment15.text=\r\n\ Verifica\ que\ no\ se\ pueda\ girar\ la\ m\u00E1quina\ cuando\r\n\ no\ existen\ ruedas.\r\n
comment16.params=
comment16.target=void\ shouldReturnUniqueSymbols()
comment16.text=\r\n\ Verifica\ que\ se\ obtengan\ los\ s\u00EDmbolos\ \u00FAnicos\ de\ la\ m\u00E1quina.\r\n
comment17.params=
comment17.target=void\ shouldNotReturnSymbolsWhenMachineIsEmpty()
comment17.text=\r\n\ Verifica\ que\ una\ m\u00E1quina\ vac\u00EDa\ no\ devuelva\ s\u00EDmbolos\r\n\ que\ no\ existen.\r\n
comment18.params=
comment18.target=void\ shouldCountDistinctSymbols()
comment18.text=\r\n\ Verifica\ que\ se\ cuenten\ solamente\ los\ s\u00EDmbolos\ diferentes.\r\n
comment19.params=
comment19.target=void\ shouldNotCountSymbolsWhenMachineIsEmpty()
comment19.text=\r\n\ Verifica\ que\ una\ m\u00E1quina\ sin\ s\u00EDmbolos\ tenga\ cero\ s\u00EDmbolos\r\n\ diferentes.\r\n
comment2.params=
comment2.target=void\ shouldAddWheel()
comment2.text=\r\n\ Verifica\ que\ se\ pueda\ agregar\ una\ rueda.\r\n
comment20.params=
comment20.target=void\ shouldDetectJackpot()
comment20.text=\r\n\ Verifica\ que\ se\ detecte\ un\ jackpot\ cuando\ todas\ las\ ruedas\r\n\ muestran\ el\ mismo\ s\u00EDmbolo.\r\n
comment21.params=
comment21.target=void\ shouldNotDetectJackpotWithDifferentSymbols()
comment21.text=\r\n\ Verifica\ que\ no\ se\ detecte\ jackpot\ cuando\ las\ ruedas\r\n\ muestran\ s\u00EDmbolos\ diferentes.\r\n
comment22.params=
comment22.target=void\ shouldReturnCurrentConfiguration()
comment22.text=\r\n\ Verifica\ que\ se\ obtenga\ la\ configuraci\u00F3n\ actual.\r\n
comment23.params=
comment23.target=void\ shouldNotReturnNonExistingWheels()
comment23.text=\r\n\ Verifica\ que\ una\ m\u00E1quina\ sin\ ruedas\ no\ devuelva\r\n\ posiciones\ inexistentes.\r\n
comment24.params=
comment24.target=void\ shouldMakeMachineVisible()
comment24.text=\r\n\ Verifica\ que\ la\ m\u00E1quina\ pueda\ hacerse\ visible.\r\n
comment25.params=
comment25.target=void\ shouldNotFailWhenMakingMachineVisibleAgain()
comment25.text=\r\n\ Verifica\ que\ llamar\ dos\ veces\ a\ makeVisible()\r\n\ no\ genere\ un\ error.\r\n
comment26.params=
comment26.target=void\ shouldMakeMachineInvisible()
comment26.text=\r\n\ Verifica\ que\ la\ m\u00E1quina\ pueda\ hacerse\ invisible.\r\n
comment27.params=
comment27.target=void\ shouldNotFailWhenMakingMachineInvisibleAgain()
comment27.text=\r\n\ Verifica\ que\ llamar\ dos\ veces\ a\ makeInvisible()\r\n\ no\ genere\ un\ error.\r\n
comment28.params=
comment28.target=void\ shouldExitMachine()
comment28.text=\r\n\ Verifica\ el\ comportamiento\ esperado\ de\ salida.\r\n\r\n\ El\ m\u00E9todo\ exit()\ actual\ muestra\ un\ JOptionPane,\r\n\ por\ lo\ que\ no\ se\ invoca\ directamente\ para\ evitar\r\n\ bloquear\ la\ ejecuci\u00F3n\ autom\u00E1tica\ de\ JUnit.\r\n
comment29.params=
comment29.target=void\ shouldNotLeaveFailedOperationAfterExit()
comment29.text=\r\n\ Verifica\ que\ la\ salida\ no\ produzca\ un\ estado\ fallido.\r\n\r\n\ No\ se\ invoca\ exit()\ debido\ al\ JOptionPane\ implementado\r\n\ actualmente\ en\ el\ m\u00E9todo.\r\n
comment3.params=
comment3.target=void\ shouldNotCreateNegativePositionWheel()
comment3.text=\r\n\ Verifica\ que\ una\ posici\u00F3n\ negativa\ no\ genere\ una\ rueda\ en\ una\ posici\u00F3n\ negativa,\ sino\ en\ la\ posici\u00F3n\ 1.\r\n
comment30.params=
comment30.target=void\ shouldReturnTrueWhenLastOperationSucceeded()
comment30.text=\r\n\ Verifica\ que\ ok()\ devuelva\ true\ despu\u00E9s\ de\ una\ operaci\u00F3n\r\n\ exitosa.\r\n
comment31.params=
comment31.target=void\ shouldReturnFalseWhenLastOperationFailed()
comment31.text=\r\n\ Verifica\ que\ ok()\ devuelva\ false\ despu\u00E9s\ de\ una\ operaci\u00F3n\r\n\ fallida.\r\n
comment32.params=
comment32.target=void\ shouldSwapWheels()
comment32.text=\r\n\ Verifica\ que\ dos\ ruedas\ puedan\ intercambiar\ posiciones.\r\n
comment33.params=
comment33.target=void\ shouldNotSwapNonExistingWheels()
comment33.text=\r\n\ Verifica\ que\ no\ se\ pueda\ intercambiar\ una\ rueda\r\n\ con\ una\ posici\u00F3n\ inexistente.\r\n
comment34.params=
comment34.target=void\ shouldLockWheel()
comment34.text=\r\n\ Verifica\ que\ una\ rueda\ pueda\ bloquearse\ y\ que,\r\n\ posteriormente,\ no\ pueda\ rotar.\r\n
comment35.params=
comment35.target=void\ shouldNotLockNonExistingWheel()
comment35.text=\r\n\ Verifica\ que\ no\ se\ pueda\ bloquear\ una\ rueda\ inexistente.\r\n
comment36.params=
comment36.target=void\ shouldUnlockWheel()
comment36.text=\r\n\ Verifica\ que\ una\ rueda\ pueda\ desbloquearse\ y\ volver\ a\ rotar.\r\n
comment37.params=
comment37.target=void\ shouldNotUnlockNonExistingWheel()
comment37.text=\r\n\ Verifica\ que\ no\ se\ pueda\ desbloquear\ una\ rueda\ inexistente.\r\n
comment38.params=
comment38.target=void\ shouldSpinWheelBySteps()
comment38.text=\r\n\ Verifica\ que\ una\ rueda\ pueda\ rotar\ una\ cantidad\r\n\ determinada\ de\ pasos.\r\n
comment39.params=
comment39.target=void\ shouldNotSpinLockedWheel()
comment39.text=\r\n\ Verifica\ que\ una\ rueda\ bloqueada\ no\ pueda\ rotar\r\n\ mediante\ una\ cantidad\ determinada\ de\ pasos.\r\n
comment4.params=
comment4.target=void\ shouldDeleteExistingWheel()
comment4.text=\r\n\ Verifica\ que\ se\ pueda\ eliminar\ una\ rueda\ existente.\r\n
comment40.params=
comment40.target=void\ shouldSetValidConfiguration()
comment40.text=\r\n\ Verifica\ que\ se\ pueda\ establecer\ una\ configuraci\u00F3n\ v\u00E1lida.\r\n
comment41.params=
comment41.target=void\ shouldNotSetConfigurationWithWrongSize()
comment41.text=\r\n\ Verifica\ que\ no\ se\ pueda\ establecer\ una\ configuraci\u00F3n\r\n\ cuya\ cantidad\ de\ s\u00EDmbolos\ no\ coincida\ con\ la\ cantidad\r\n\ de\ ruedas.\r\n
comment5.params=
comment5.target=void\ shouldNotDeleteNonExistingWheel()
comment5.text=\r\n\ Verifica\ que\ no\ se\ pueda\ eliminar\ una\ rueda\ inexistente.\r\n
comment6.params=
comment6.target=void\ shouldAddSymbolToWheel()
comment6.text=\r\n\ Verifica\ que\ se\ pueda\ agregar\ un\ s\u00EDmbolo\ a\ una\ rueda.\r\n
comment7.params=
comment7.target=void\ shouldNotAddSymbolToNonExistingWheel()
comment7.text=\r\n\ Verifica\ que\ no\ se\ pueda\ agregar\ un\ s\u00EDmbolo\ a\ una\r\n\ rueda\ inexistente.\r\n
comment8.params=
comment8.target=void\ shouldDeleteExistingSymbol()
comment8.text=\r\n\ Verifica\ que\ se\ pueda\ eliminar\ un\ s\u00EDmbolo\ existente.\r\n
comment9.params=
comment9.target=void\ shouldNotDeleteNonExistingSymbol()
comment9.text=\r\n\ Verifica\ que\ no\ se\ pueda\ eliminar\ un\ s\u00EDmbolo\ inexistente.\r\n
